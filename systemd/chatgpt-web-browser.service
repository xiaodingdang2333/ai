[Unit]
Description=Persistent ChatGPT browser for web novel production
After=network-online.target xvfb-99.service
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=DISPLAY=:99
ExecStartPre=/usr/bin/install -d -m 700 -o root -g root /run/user/0 /run/user/0/snap.chromium
ExecStartPre=/usr/bin/rm -f /home/admin/ai/.chatgpt-web-profile/SingletonLock /home/admin/ai/.chatgpt-web-profile/SingletonCookie /home/admin/ai/.chatgpt-web-profile/SingletonSocket
ExecStart=/root/.cache/puppeteer/chrome/linux-131.0.6778.204/chrome-linux64/chrome --no-sandbox --disable-dev-shm-usage --disable-gpu --no-first-run --password-store=basic --remote-debugging-address=127.0.0.1 --remote-debugging-port=9224 --remote-allow-origins=* --user-data-dir=/home/admin/ai/.chatgpt-web-profile https://chatgpt.com/
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
