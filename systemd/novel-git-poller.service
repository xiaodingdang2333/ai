[Unit]
Description=Scan ChatGPT novel Git repository for server jobs

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/home/admin/ai
ExecStart=/usr/bin/python3 /home/admin/ai/scripts/novel-git-poller.py --repo /home/admin/chatgpt-novel-production-system --fetch --json
ExecStopPost=/usr/bin/chown -R admin:admin /home/admin/chatgpt-novel-production-system
