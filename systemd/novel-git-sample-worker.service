[Unit]
Description=Process ChatGPT novel sample requests from Git

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/home/admin/ai
ExecStart=/usr/bin/python3 /home/admin/ai/scripts/novel-git-sample-worker.py --repo /home/admin/chatgpt-novel-production-system --execute --git-commit --git-push --limit 3 --json
ExecStopPost=/usr/bin/chown -R admin:admin /home/admin/chatgpt-novel-production-system
