[Unit]
Description=Process explicit server Codex novel write requests

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/home/admin/ai
ExecStartPre=/usr/bin/python3 /home/admin/ai/scripts/novel-git-sync.py --repo /home/admin/chatgpt-novel-production-system-runtime --json
ExecStart=/usr/bin/python3 /home/admin/ai/scripts/novel-git-write-worker.py --repo /home/admin/chatgpt-novel-production-system-runtime --execute --git-commit --git-push --limit 1 --json
ExecStopPost=/usr/bin/chown -R admin:admin /home/admin/chatgpt-novel-production-system-runtime
