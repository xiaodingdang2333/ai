[Unit]
Description=Upload Git-ready ChatGPT novels to Fanqie drafts

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/home/admin/ai
ExecStart=/usr/bin/python3 /home/admin/ai/scripts/novel-git-upload-worker.py --repo /home/admin/chatgpt-novel-production-system --execute --git-commit --git-push --limit 1 --json
ExecStopPost=/usr/bin/chown -R admin:admin /home/admin/chatgpt-novel-production-system
